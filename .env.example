# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Never commit real keys, and never paste them into chat.

# Public address of the site (used for links in emails, the sitemap and share images).
NEXT_PUBLIC_SITE_URL=

# --- Clerk (accounts): Dashboard → API keys ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard → Webhooks → your endpoint → Signing secret (Phase 2)
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Supabase (database + storage): Dashboard → Project settings → API keys ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Bypasses row-level security.
SUPABASE_SECRET_KEY=

# --- Admin area: the founder's Clerk user id (Clerk Dashboard → Users → the user → User ID) ---
FOUNDER_CLERK_USER_ID=
# The admin password, as a scrypt hash only (never the password itself). To set or change it:
#   node -e "const c=require('crypto'),s=c.randomBytes(16);console.log('scrypt\$'+s.toString('base64url')+'\$'+c.scryptSync(process.argv[1].normalize('NFC'),s,32,{N:16384,r:8,p:1}).toString('base64url'))" 'new-password'
# Changing it signs every open admin session out.
ADMIN_PASSWORD_HASH=

# --- Email (Resend): API key, and a sender on your own verified domain ---
RESEND_API_KEY=
# e.g. House of Kanishka <care@yourdomain.com>
EMAIL_FROM= House of Kanishka <orders@houseofkanishka.in>
# Where contact-form messages are copied to
CONTACT_NOTIFY_EMAIL=

# Brevo (newsletter list). Optional: without them subscribers are kept only in our own table.
BREVO_API_KEY=
BREVO_LIST_ID=

# Razorpay webhook (dashboard → Settings → Webhooks → Secret). URL: /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Bot protection: Cloudflare Turnstile (free; dash.cloudflare.com → Turnstile → Add widget,
#     hostname www.houseofkanishka.in, mode "Invisible"). Off while empty. Optional TURNSTILE_HOSTNAMES
#     (comma-separated) overrides the accepted page hostnames (default: this site and its bare domain). ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Shipping: Delhivery (B2C API). Everything Delhivery-related stays off while these are empty. ---
# Address: https://staging-express.delhivery.com for testing, https://track.delhivery.com when live.
# The token must belong to that address (staging and live tokens are different):
#   One Panel → Settings → API Setup → Existing API Token → View/Copy
DELHIVERY_BASE_URL=
DELHIVERY_API_TOKEN= 
# Our pickup address's warehouse name in Delhivery, exactly as registered (case and spaces count).
DELHIVERY_PICKUP_LOCATION=
# Shared secret for the 2-hourly tracking sync (/api/cron/delhivery). Any long random string;
# put the same value in GitHub → Settings → Secrets → Actions as CRON_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
